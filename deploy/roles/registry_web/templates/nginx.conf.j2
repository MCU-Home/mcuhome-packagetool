The three vhosts differ only in what they are allowed to serve, so the
cache and content-type rules are written once as macros and used from
each of them. What ends up on the server is a plain nginx configuration
with every rule spelled out.
#}
{% macro immutable() %}
            # Immutable: the name can never stand for different bytes.
            # Deliberately WITHOUT "always": with it, nginx also attaches
            # this header to error responses (notably 404), and a client
            # or an intermediary that probes a not-yet-published name
            # would then cache "not here" for a year and never see the
            # file once it exists. Without "always", nginx only sends the
            # header on 2xx/3xx, which is exactly the set of responses
            # for which "this name is permanent" is true.
            add_header Cache-Control "public, max-age={{ registry_web_immutable_max_age }}, immutable";
{%- endmacro %}
{% macro revalidate() %}
            # Always revalidated: this document is replaced in place, and
            # a stale copy is exactly what the freshness rules exist to
            # catch. "always" is safe and wanted here even on error
            # responses: "no-cache" does not forbid storing the response,
            # it only forbids serving it again without asking first, so a
            # cached 404 is re-checked on the very next request instead of
            # being served stale for any length of time.
            add_header Cache-Control "no-cache" always;
{%- endmacro %}
{% macro cors() %}
{%- if registry_web_cors_origin %}
            # Readable by a browser on another host; see the head of this
            # file. "always", so a 404 arrives at the page as a 404 rather
            # than as an unexplained network error.
            add_header Access-Control-Allow-Origin "{{ registry_web_cors_origin }}" always;
{%- endif %}
{%- endmacro %}
{% macro static_page(file) %}
            # Installed beside the tree, not in it: a registry is a file tree
            # a mirror copies byte for byte, and a page belongs to the host
            # that serves it rather than to what is published. Hence a root
            # of its own for this one location.
            #
            # try_files and not "alias <file>": the request URI is "/", and
            # for a URI ending in "/" nginx's index module appends the index
            # file to whatever the path resolves to — which turns an alias
            # naming a file into "<file>index.html". try_files hands the file
            # out directly, and answers 404 if it is not there.
            root {{ registry_web_assets_dir }};
            try_files /{{ file }} =404;
{{ revalidate() }}
{%- endmacro %}
{% macro tree_server_head(port) %}
    listen {{ registry_web_listen_address }}:{{ port }};
    server_name _;

    # The docroot is a symlink that a publish replaces. It is resolved
    # per request, which is what makes the switch atomic for clients;
    # open_file_cache would cache the old target and is therefore not
    # configured here.
    root {{ registry_root }}/current;

    # No "index" directive: the tree carries no HTML at all any more.
    # What a directory is answered with is each vhost's own business —
    # a listing, or a 404 — and the pages are files of this server
    # rather than of the registry.

    # A registry is read-only. "if" with nothing but a return in it is
    # one of the two uses of it that are safe.
    if ($request_method !~ ^(GET|HEAD)$) {
        return 405;
    }
{%- endmacro %}
# SPDX-FileCopyrightText: 2026 The MCUHome Contributors
# SPDX-License-Identifier: Apache-2.0
#
# {{ ansible_managed }}
#
# nginx serving a packagetool registry. It sits behind the reverse proxy
# and listens on {{ registry_web_listen_address }} only: it terminates no
# TLS, knows no host names, and answers whatever the proxy sends it.
#
# Three servers, one port each, because they serve three different
# things:
#
#   {{ registry_web_tree_port }}  the full registry tree, through <root>/current
{% if registry_web_bootstrap_enabled %}
#   {{ registry_web_bootstrap_port }}  the bootstrap subset: the documents a client needs to
#         find a mirror, and nothing else of the tree
{% endif %}
{% if registry_web_mirror_sync_enabled %}
#   {{ registry_web_mirror_sync_port }}  the dump distribution for official mirrors, out of
#         <root>/mirror-sync
{% endif %}
#
# The tree carries no HTML. Where a browser gets a page at all — the root
# of the tree vhost, the root of the bootstrap vhost — it is a file of
# this server, installed beside this configuration, and never part of
# what a mirror copies.
{% if registry_web_cors_origin %}
#
# The JSON documents of the full tree are readable across origins
# (Access-Control-Allow-Origin: {{ registry_web_cors_origin }}). The pages of a registry are
# served by one host and the data by another — that is what a mirror list
# is for — so the page's requests are cross-origin by construction, and a
# browser refuses them unless the mirror says otherwise. Nothing is given
# away by it: every document it applies to is public, unauthenticated and
# fetchable with curl by anyone. Package files are left out of it, since
# nothing reads them with a script.
{% endif %}
#
# Nothing is compressed here, deliberately. Package files are compressed
# already, the documents are a kilobyte each, and on-the-fly compression
# is the classic way to lose byte ranges on the large files that need
# them most.

{% if registry_web_autoindex and registry_web_autoindex_xslt %}
# Directory listings are rendered from nginx's own XML output by a
# stylesheet, in the server, so a listing needs no JavaScript and no
# assets. The filter is a dynamic module: the official nginx images ship
# it, an image that does not have it makes this line fail at startup, and
# an image without it can still serve listings by setting
# registry_web_autoindex_xslt to false. Only this server's own autoindex
# output is ever transformed — nothing else here is text/xml.
load_module {{ registry_web_xslt_module }};

{% endif %}
worker_processes auto;
error_log /dev/stderr warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # The client address is the proxy's, so the address worth logging is
    # the one the proxy forwarded. The requested range is logged too: a
    # partial fetch of a large package looks like a truncated download
    # otherwise.
    log_format registry '$http_x_forwarded_for "$request" $status $body_bytes_sent '
                        'range="$http_range" "$http_user_agent"';
    access_log /dev/stdout registry;

    sendfile on;
    tcp_nopush on;
    server_tokens off;
    charset utf-8;

    # Redirects stay relative. An absolute one would be built from the
    # host and port nginx sees, and what it sees is the proxy.
    absolute_redirect off;
    port_in_redirect off;

    keepalive_timeout 65s;
    client_max_body_size 1k;
    client_body_timeout 10s;
    send_timeout 60s;

    # The full registry tree.
    server {
{{ tree_server_head(registry_web_tree_port) }}

        autoindex {{ 'on' if registry_web_autoindex else 'off' }};
{% if not registry_web_autoindex %}

        # A directory without an index file is a 404, not a 403. There is
        # nothing forbidden about it, and a public file tree has no use
        # for the distinction.
        error_page 403 = @missing;

        location @missing {
            return 404;
        }
{% endif %}
{% if registry_web_tree_index_page %}

        # --- the page at the root --------------------------------------
        # Exactly "/" and nothing else: every other directory is answered
        # by the listing, and this page is not in the tree at all.
        location = / {
{{ static_page('tree-index.html') }}
        }
{% endif %}

        # --- the signed head documents ---------------------------------
        location = /sources.json {
{{ revalidate() }}{{ cors() }}
        }

        location = /anchor.json {
{{ revalidate() }}{{ cors() }}
        }

        location ~ ^/[^/]+/(index|keys|mirrors)\.json$ {
{{ revalidate() }}{{ cors() }}
        }

        location ~ ^/[^/]+/(index|keys|mirrors)\.json\.sig$ {
            # A signature envelope is JSON; the extension is not in any
            # mime.types.
            default_type application/json;
{{ revalidate() }}{{ cors() }}
        }

        # --- written once, never rewritten -----------------------------
        # An archived key set is named after the moment it was issued and
        # is never replaced, and an index part carries the hash of its own
        # content in its name. Both are safe to keep forever.
        location ~ ^/[^/]+/keys/[^/]+\.json$ {
{{ immutable() }}{{ cors() }}
        }

        location ~ ^/[^/]+/keys/[^/]+\.json\.sig$ {
            default_type application/json;
{{ immutable() }}{{ cors() }}
        }

        location ~ "^/[^/]+/index-.+-[0-9a-f]{16}\.json$" {
            # Quoted because of the braces: nginx would read them as the
            # start of a block otherwise.
{{ immutable() }}{{ cors() }}
        }

        # --- package files ---------------------------------------------
        # A published version is immutable and is never deleted, so its
        # bytes and its two sidecars never change either — the checksum,
        # and the meta file whose hash the signed index records.
        location ~ \.tar\.zst$ {
            default_type application/zstd;
{{ immutable() }}
        }

        location ~ \.tar\.zst\.sha256$ {
            default_type text/plain;
{{ immutable() }}
        }

        location ~ \.tar\.zst\.meta\.json$ {
            default_type application/json;
{{ immutable() }}
        }

        # --- everything else --------------------------------------------
        # Directories end up here too: none of the rules above matches a
        # path that ends in "/", so this is also where a listing is
        # rendered.
        location / {
            # Short-lived by design (5 min default), so "always" is fine
            # here even on a 404: this is also the conservative fallback
            # for a not-yet-published name that falls through to this
            # location — a client caches "not here" for minutes, not a
            # year, and sees the file soon after it appears.
            add_header Cache-Control "public, max-age={{ registry_web_default_max_age }}" always;
{% if registry_web_autoindex and registry_web_autoindex_xslt %}

            # The listing nginx generates as XML, turned into a page by
            # the stylesheet installed beside the configuration. Here and
            # not in the server block, because xslt_stylesheet is a
            # location directive — and this is the only location a
            # directory can reach. The stylesheet is read and compiled
            # while the configuration is loaded, so a broken or missing
            # one is a server that refuses to start rather than one that
            # answers with something odd. The XML carries no path, so the
            # requested one is passed in separately.
            autoindex_format xml;
            xslt_stylesheet {{ registry_web_assets_dir }}/autoindex.xslt;
            xslt_string_param uri $uri;
{% endif %}
        }
    }
{% if registry_web_bootstrap_enabled %}

    # The bootstrap subset. Same tree, but only the documents a client
    # needs to get from "I have an anchor and a source name" to "I know
    # which mirror to fetch from": the anchor, the key set it verifies
    # against it, the archived key sets it may have to walk back through,
    # and the signed mirror list — plus, when configured, the page at the
    # root. No index.json, no packages: a client that resolved a package
    # here would find nothing to download, and a host that answers with
    # half a source is worse than one that answers with none of it.
    server {
{{ tree_server_head(registry_web_bootstrap_port) }}

        autoindex off;

        location = /anchor.json {
{{ revalidate() }}
        }

        location = /sources.json {
{{ revalidate() }}
        }

        location ~ ^/[^/]+/(keys|mirrors)\.json$ {
{{ revalidate() }}
        }

        location ~ ^/[^/]+/(keys|mirrors)\.json\.sig$ {
            default_type application/json;
{{ revalidate() }}
        }

        location ~ ^/[^/]+/keys/[^/]+\.json$ {
{{ immutable() }}
        }

        location ~ ^/[^/]+/keys/[^/]+\.json\.sig$ {
            default_type application/json;
{{ immutable() }}
        }

{% if registry_web_bootstrap_page %}
        # The page that explains this registry and browses it. It is served
        # here rather than from a mirror because this is the host a client
        # starts at, and it reads exactly what this vhost serves: the
        # source list and each source's mirror list. Everything it shows
        # about packages it fetches from the mirror a visitor picked.
        location = / {
{{ static_page('bootstrap-index.html') }}
        }

{% elif registry_web_bootstrap_redirect %}
        location = / {
            return 302 {{ registry_web_bootstrap_redirect }};
        }

{% endif %}
        # Everything not named above does not exist here. Deny by
        # construction: the rules add files, they do not subtract them.
        location / {
            return 404;
        }
    }
{% endif %}
{% if registry_web_mirror_sync_enabled %}

    # The dump distribution for official mirrors. Its docroot is beside
    # the served tree, not inside it, so no path under the public vhosts
    # can reach it. Who may read it is decided by the reverse proxy in
    # front — nothing here is public.
    server {
        listen {{ registry_web_listen_address }}:{{ registry_web_mirror_sync_port }};
        server_name _;

        root {{ registry_root }}/mirror-sync;
        autoindex off;

        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }

        # One chain per source, so a mirror can follow one source without
        # taking the whole registry. The index is polled, usually with
        # HEAD against its ETag, and it is rewritten whenever a dump of
        # that source is added or dropped.
        location ~ ^/[^/]+/index\.json$ {
{{ revalidate() }}
        }

        # A dump is named after the snapshot it carries and is written
        # once.
        location ~ ^/[^/]+/(full|snapshot)-[^/]+\.btrfs\.dump$ {
{{ immutable() }}
        }

        location / {
            return 404;
        }
    }
{% endif %}
}
