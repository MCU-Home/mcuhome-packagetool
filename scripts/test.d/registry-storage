#
# deploy/tests/registry-storage: the registry_storage role run against
# real loopback block devices — the three refusals, the mounted volume
# root, formatting an empty device and adopting an existing btrfs one.
#
# The role is run with this repository's own ansible-playbook, so the
# roles are exercised with the ansible-core the dev group pins. The test
# needs root, loop devices and the filesystem tools, and skips itself
# (exit 77) when it cannot have them. A skip is not a pass, so this
# wrapper checks the same prerequisites first and fails with what to do
# about it.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"
test_script="$root/deploy/tests/registry-storage"
name="test.d/registry-storage"

if [ ! -x "$test_script" ]; then
  echo "$name: $test_script is not there or not executable." >&2
  exit 1
fi

if [ ! -x "$venv/bin/ansible-playbook" ]; then
  echo "$name: no .venv found. Create it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "$name: needs root — it creates loop devices and mounts filesystems." >&2
  echo "Run: sudo scripts/test registry-storage" >&2
  exit 1
fi

missing=()
for binary in mkfs.btrfs btrfs mkfs.ext4 pvcreate sfdisk losetup mount umount findmnt blkid unshare; do
  command -v "$binary" >/dev/null 2>&1 || missing+=("$binary")
done
if [ "${#missing[@]}" -gt 0 ]; then
  echo "$name: missing ${missing[*]}. Install the filesystem tools first" >&2
  echo "(e.g. apt install btrfs-progs e2fsprogs lvm2 fdisk util-linux)." >&2
  exit 1
fi

status=0
ANSIBLE_PLAYBOOK="$venv/bin/ansible-playbook" "$test_script" "$@" || status=$?
if [ "$status" -eq 77 ]; then
  echo "$name: the test skipped itself although the prerequisites are met — see its" >&2
  echo "SKIP message above. Treated as a failure, because a skipped check proves nothing." >&2
  exit 1
fi
exit "$status"
